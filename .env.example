# Copy this file to .env and fill in your values before running docker-compose.
# The .env file is git-ignored and should NEVER be committed.

# SQL Server SA password (min 8 chars, must include uppercase, lowercase, digit, symbol)
SA_PASSWORD=YourStrong!Password123

# JWT signing key – use a long random string (32+ characters)
JWT_KEY=replace-with-a-long-random-secret-key-here

# OpenAI API key
OPENAI_API_KEY=sk-proj-...
